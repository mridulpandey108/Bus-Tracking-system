-- ================= RESET =================
DROP DATABASE IF EXISTS bus_tracking;
CREATE DATABASE bus_tracking;
USE bus_tracking;

-- ================= USERS =================
CREATE TABLE users (
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100),
  phone VARCHAR(15) UNIQUE,
  password VARCHAR(255)
);

-- ================= BUSES =================
CREATE TABLE buses (
  id INT AUTO_INCREMENT PRIMARY KEY,
  bus_number VARCHAR(20),
  rto_number VARCHAR(20)
);

-- ================= ROUTES =================
CREATE TABLE routes (
  id INT AUTO_INCREMENT PRIMARY KEY,
  route_name VARCHAR(255)
);

-- ================= STOPS (FIXED) =================
CREATE TABLE stops (
  id INT AUTO_INCREMENT PRIMARY KEY,
  stop_name VARCHAR(255) UNIQUE,
  latitude DECIMAL(10,6),
  longitude DECIMAL(10,6)
);

-- ================= DRIVERS =================
CREATE TABLE drivers_auth (
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100),
  phone VARCHAR(15) UNIQUE,
  password VARCHAR(255),
 bus_id INT,
  FOREIGN KEY (bus_id) REFERENCES buses(id)
);

-- ================= ROUTE STOPS =================
CREATE TABLE route_stops (
  id INT AUTO_INCREMENT PRIMARY KEY,
  route_id INT,
  stop_id INT,
  stop_order INT,
  arrival_time TIME,
  FOREIGN KEY (route_id) REFERENCES routes(id) ON DELETE CASCADE,
  FOREIGN KEY (stop_id) REFERENCES stops(id) ON DELETE CASCADE
);

-- ================= ACTIVE BUSES =================
-- ================= ACTIVE BUSES =================
CREATE TABLE active_buses (
  id INT AUTO_INCREMENT PRIMARY KEY,
  bus_id INT UNIQUE,            -- 🔥 FIX: ek bus ek hi baar active hogi
  driver_id INT UNIQUE,         -- already tha (ek driver ek bus)
  route_id INT,
  start_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

  FOREIGN KEY (bus_id) REFERENCES buses(id),
  FOREIGN KEY (driver_id) REFERENCES drivers_auth(id) ON DELETE CASCADE,
  FOREIGN KEY (route_id) REFERENCES routes(id)
);

-- ================= BUS LOCATIONS =================
CREATE TABLE bus_locations (
  id INT AUTO_INCREMENT PRIMARY KEY,
  active_bus_id INT,
  latitude DECIMAL(10,6),
  longitude DECIMAL(10,6),
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (active_bus_id) 
    REFERENCES active_buses(id) 
    ON DELETE CASCADE
);

-- ================= INDEX =================
CREATE INDEX idx_active_bus ON bus_locations(active_bus_id);
CREATE INDEX idx_route ON active_buses(route_id);
CREATE INDEX idx_driver ON active_buses(driver_id);

-- ================= TRIGGER =================
DROP TRIGGER IF EXISTS after_driver_insert;



DELIMITER $$

CREATE TRIGGER after_driver_insert
BEFORE INSERT ON drivers_auth
FOR EACH ROW
BEGIN
  INSERT INTO users (name, phone, password)
  VALUES (NEW.name, NEW.phone, NEW.password)
  ON DUPLICATE KEY UPDATE 
    name = NEW.name;

  IF NEW.bus_id IS NULL OR NEW.bus_id = 0 THEN
    SET NEW.bus_id = (
      SELECT id FROM buses LIMIT 1
    );
  END IF;
END$$

DELIMITER ;

